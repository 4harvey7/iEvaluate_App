# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Environment / Secrets
# .env is listed here but is ALSO excluded from pubspec.yaml assets.
# .env.json is used with --dart-define-from-file at build time — never commit it.
.env
.env.json

# The two entries above match those names exactly, so a copy made while
# rotating keys (.env.json.bak) slipped past them and was staged for commit.
# Cover the copies and the scratch files a rotation produces as well.
.env.*
!.env.example
!.env.json.example
*.env.bak
*.key
n8n.key

# Files used to hand a freshly-rotated key to a script. These hold live
# credentials in plain text and belong nowhere near a commit.
supabase_*_key*.txt
*_secret_key*.txt

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Build artifacts
*.apk

# Cleanup trash
_trash_removed_files/

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase Config
android/app/google-services.json
