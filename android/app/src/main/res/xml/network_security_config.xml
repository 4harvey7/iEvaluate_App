<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Enforce TLS/HTTPS across the entire app.
      Cleartext HTTP traffic (such as http://...) is strictly blocked.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
